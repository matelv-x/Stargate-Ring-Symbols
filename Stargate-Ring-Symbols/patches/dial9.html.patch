+        const ringStepsPerRevolution = 1250;
+        const symbolStepPositions = {
+          1: 0,
+          2: 32,
+          3: 64,
+          4: 96,
+          5: 128,
+          6: 160,
+          7: 192,
+          8: 224,
+          9: 256,
+          10: 288,
