+          for (let i = 0; i < symbols.length; i++) {
+            const symbol = symbols[i];
+
+            // Use the real backend SG1 ring mapping from symbol_ring.py.
+            // 1250 ring steps = full revolution.
+            // Symbol 1 / Earth = step 0 = 12 o'clock.
+            // Symbols increase clockwise/right in steps of 32.
+            const angle = symbolIndexToAngle(symbol.index);
+            const point = getRingPoint(angle, ringRadius);
