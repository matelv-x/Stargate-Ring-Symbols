+            .replace(/<\/svg>/i, '');
+        }
+
+        function resolveImagePath(imageSrc) {
+          if (!imageSrc) return '';
+          if (imageSrc.startsWith('http://') || imageSrc.startsWith('https://')) return imageSrc;
