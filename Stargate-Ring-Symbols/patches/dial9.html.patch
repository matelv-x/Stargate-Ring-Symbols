+
+        function symbolIndexToAngle(symbolIndex) {
+          const stepPosition = symbolStepPositions[Number(symbolIndex)];
+          if (!Number.isFinite(stepPosition)) return 0;
+          return (stepPosition / ringStepsPerRevolution) * 360;
+        }
+
+        function getRingPoint(angleDegrees, radius) {
+          const angleRadians = (angleDegrees * Math.PI) / 180;
+          return {
+            x: centerX + radius * Math.sin(angleRadians),
+            y: centerY - radius * Math.cos(angleRadians),
+          };
+        }
+
+        function getSymbolSize(svgText) {
+          const viewBoxMatch = svgText.match(/viewBox=["']([^"']+)["']/i);
+          if (viewBoxMatch) {
+            const parts = viewBoxMatch[1].trim().split(/[\s,]+/).map(Number);
+            if (parts.length === 4 && parts.every(Number.isFinite)) {
+              return {x: parts[0], y: parts[1], width: parts[2], height: parts[3]};
+            }
+          }
+          return {x: 0, y: 0, width: 64, height: 64};
+        }
+
