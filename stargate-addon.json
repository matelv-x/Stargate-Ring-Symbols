{
  "maintenance_contract": 1,
  "uninstall_contract": 2,
  "id": "stargate-ring-symbols",
  "name": "Stargate Ring Symbols",
  "repository": "matelv-x/Stargate-Ring-Symbols",
  "platforms": ["v4"],
  "detect": {"any": [{"path": "web/retro/dial.html", "contains": "sg1-ring-segment"}, {"path": "web/retro/dial9.html", "contains": "sg1-ring-segment"}]},
  "install": {"argv": ["./apply-ring-symbols-upgrade.sh", "{web_root}"], "timeout": 900},
  "uninstall": {"argv": ["./restore.sh", "{web_root}"], "timeout": 900},
  "restart_required": true
}
